# Copy to backend/.env and fill in real values. backend/.env is git-ignored.
# Without a .env file the backend falls back to the local Docker Compose defaults.

# Runtime connection: the restricted role (NOSUPERUSER, NOBYPASSRLS) so row-level security applies.
# Use a direct (non-pooled) endpoint: the tenant id is a session setting on the connection.
DATABASE_URL=jdbc:postgresql://<host>/kazipay?sslmode=require
DATABASE_USER=kazipay_app
DATABASE_PASSWORD=<app-role-password>

# Flyway migrations: the schema owner role.
FLYWAY_URL=jdbc:postgresql://<host>/kazipay?sslmode=require
FLYWAY_USER=kazipay_owner
FLYWAY_PASSWORD=<owner-role-password>
